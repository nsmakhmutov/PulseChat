@echo off
TITLE InPulse SFU Server
:: Устанавливаем кодировку UTF-8 для корректного отображения логов
chcp 65001 >nul

:: Переходим в папку, где лежит этот батник
cd /d "%~dp0"

:: Проверяем наличие именно твоего окружения .venv
if not exist ".venv\Scripts\activate.bat" (
    echo [X] Ошибка: Виртуальное окружение .venv не найдено в этой папке!
    echo Проверь, что батник лежит в E:\Mychat\VoiceChat\
    pause
    exit /b
)

:: Активация окружения
echo [→] Активация окружения .venv...
call ".venv\Scripts\activate.bat"

:: Запуск сервера
echo [✓] Запуск сервера (TCP:5000, UDP:5001)...
echo ---------------------------------------
python server.py

:: Если сервер упадет, окно не закроется
echo ---------------------------------------
echo [!] Работа сервера завершена.
pause